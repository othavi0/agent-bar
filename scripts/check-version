#!/usr/bin/env bash
# Confirm Cargo.toml version equals optional release tag and (when present)
# the staged plugin manifest / bundle receipt.
# Usage: scripts/check-version [vX.Y.Z] [plugin-dir]
set -euo pipefail

CARGO_VER="$(grep -m1 '^version' Cargo.toml | sed -E 's/.*"(.*)".*/\1/')"
fail=0

if [ "${1:-}" != "" ]; then
  TAG="${1#v}"
  if [ "$CARGO_VER" != "$TAG" ]; then
    echo "MISMATCH: Cargo.toml=$CARGO_VER tag=$TAG" >&2
    fail=1
  fi
fi

PLUGIN_DIR="${2:-}"
if [ -n "$PLUGIN_DIR" ]; then
  if [ ! -f "$PLUGIN_DIR/manifest.json" ]; then
    echo "MISSING: $PLUGIN_DIR/manifest.json" >&2
    fail=1
  else
    MAN_VER="$(grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' "$PLUGIN_DIR/manifest.json" \
      | head -1 | sed 's/.*"\([^"]*\)"$/\1/')"
    if [ "$MAN_VER" != "$CARGO_VER" ]; then
      echo "MISMATCH: Cargo.toml=$CARGO_VER manifest=$MAN_VER" >&2
      fail=1
    fi
  fi
  if [ -f "$PLUGIN_DIR/bundle.json" ]; then
    BUN_VER="$(grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' "$PLUGIN_DIR/bundle.json" \
      | head -1 | sed 's/.*"\([^"]*\)"$/\1/')"
    if [ "$BUN_VER" != "$CARGO_VER" ]; then
      echo "MISMATCH: Cargo.toml=$CARGO_VER bundle.json=$BUN_VER" >&2
      fail=1
    fi
  fi
  if [ -x "$PLUGIN_DIR/bin/agent-bar" ]; then
    HELPER_VER="$("$PLUGIN_DIR/bin/agent-bar" version 2>/dev/null | head -1 || true)"
    if [ "$HELPER_VER" != "$CARGO_VER" ]; then
      echo "MISMATCH: Cargo.toml=$CARGO_VER helper=$HELPER_VER" >&2
      fail=1
    fi
  fi
fi

if [ "$fail" -eq 0 ]; then
  echo "version OK: $CARGO_VER"
fi
exit "$fail"
